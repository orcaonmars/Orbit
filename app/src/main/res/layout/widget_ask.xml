<?xml version="1.0" encoding="utf-8"?>
<!-- "Ask Orbit" home-screen widget (AskWidgetProvider). Only RemoteViews-safe views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ask_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_ask_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pill_bg"
        android:contentDescription="@string/widget_open_chat"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_hint"
            android:textColor="@color/widget_hint_text"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/widget_ask_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/shortcut_photo_long"
            android:padding="2dp"
            android:src="@drawable/ic_shortcut_photo" />

        <ImageView
            android:id="@+id/widget_ask_voice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/shortcut_voice_long"
            android:padding="2dp"
            android:src="@drawable/ic_shortcut_voice" />
    </LinearLayout>
</LinearLayout>
